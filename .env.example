# Copia este archivo a .env y completa los valores para enviar también a Dynatrace.
# Si DT_API_TOKEN queda vacío, el lab funciona solo en local.

# URL del entorno, sin barra final. Ej: https://abc12345.live.dynatrace.com
DT_ENDPOINT=

# Token de acceso con scopes: openTelemetryTrace.ingest, metrics.ingest, logs.ingest
DT_API_TOKEN=
