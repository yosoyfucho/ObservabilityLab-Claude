# Copia este archivo como credenciales.env (está en .gitignore), complétalo y cárgalo con:
#   set -a; source credenciales.env; set +a
# Nunca pongas estos valores dentro de los .tf.

DYNATRACE_ENV_URL=https://<env-id>.apps.dynatrace.com
DT_CLIENT_ID=dt0s02.XXXXXXXX
DT_CLIENT_SECRET=dt0s02.XXXXXXXX.YYYYYYYY
DT_ACCOUNT_ID=00000000-0000-0000-0000-000000000000

# Para que no te pida la variable environment_id:
TF_VAR_environment_id=<env-id>
